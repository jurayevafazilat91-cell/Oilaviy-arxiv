# Nusxa oling: .env.local (dev) yoki .env (prod). Bu faylda sir yo'q.

# --- Asosiy ---
DATABASE_URL=postgres://postgres@localhost:5433/oilaviy
APP_URL=http://localhost:3000

# --- Fayllar ---
# fs = mahalliy disk (dev / bitta server), s3 = Cloudflare R2 yoki boshqa S3-mos storage
STORAGE_DRIVER=fs
STORAGE_DIR=./.data/storage
TMP_DIR=./.data/tmp
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

MAX_IMAGE_MB=50
MAX_VIDEO_MB=2048

# Fon ishlari shu Next.js jarayonida ishlaydi
WORKER_ENABLED=true
# Faqat Vercel: /api/cron himoyasi (Vercel uni Bearer token sifatida yuboradi)
CRON_SECRET=
# Ixtiyoriy: tizimdagi ffmpeg (sukut: ffmpeg-static paketi)
FFMPEG_PATH=

# --- Gemini (ixtiyoriy; bo'sh bo'lsa AI o'chiq) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_DAILY_LIMIT=200

# --- Telegram (ixtiyoriy) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 1-256 belgi: A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE=https://api.telegram.org
# Local Bot API server ishlatilsa: true, limit 2000, fayllar papkasi
TELEGRAM_LOCAL_SERVER=false
TELEGRAM_MAX_DOWNLOAD_MB=20
TELEGRAM_LOCAL_FILES_DIR=

# --- Faqat docker-compose uchun ---
POSTGRES_PASSWORD=
# Local Bot API server (my.telegram.org → API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
