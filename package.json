{
  "name": "oilaviy-arxiv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:dev": "node scripts/dev-db.mjs",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "telegram:poll": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/telegram-poll.ts",
    "telegram:webhook": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/telegram-webhook.ts",
    "test": "node --env-file-if-exists=.env.test --import tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.3.0",
    "heic-decode": "^2.1.0",
    "lucide-react": "^1.59.0",
    "motion": "^14.4.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "engines": {
    "node": ">=22.12"
  }
}
